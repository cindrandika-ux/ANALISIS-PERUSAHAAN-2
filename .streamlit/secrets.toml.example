# CONTOH — salin menjadi secrets.toml lalu ganti kata sandinya.
# JANGAN commit file secrets.toml asli (sudah ada di .gitignore).
# Untuk Streamlit Cloud: tempel isi ini di Manage app -> Settings -> Secrets.
[passwords]
tamu = "ganti-kata-sandi-ini"

# Daftar username yang boleh membuka halaman admin pendaftar.
[admins]
daftar = ["tamu"]

# Pengaturan email verifikasi + alamat aplikasi (wajib untuk kirim email).
# Untuk Gmail: buat App Password di myaccount.google.com/apppasswords.
# Untuk Streamlit Cloud: tempel blok ini juga di Manage app -> Settings -> Secrets.
[app]
url_aplikasi = "http://localhost:8501"

[smtp]
host = "smtp.gmail.com"
port = 587
username = "email-anda@gmail.com"
password = "isi-app-password-disini"
pengirim = "email-anda@gmail.com"
